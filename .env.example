# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי את הערכים.
# אסור להעלות את .env ל־GitHub! (הוא כבר מופיע ב־.gitignore)

# סביבה: development / production
NODE_ENV=development

# הפורט שהשרת מאזין לו. ב־Render הפורט נקבע אוטומטית.
PORT=3000

# כתובת החיבור למסד הנתונים PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otzar?schema=public"

# מסד נתונים נפרד לבדיקות האוטומטיות (npm test). הבדיקות מוחקות בו נתונים!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otzar_test?schema=public"

# מפתח סודי לחתימת הטוקנים – לפחות 32 תווים אקראיים. לעולם לא לשתף.
# אפשר ליצור כך: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"

# כמה זמן הכניסה תקפה (2h = שעתיים)
JWT_EXPIRES_IN=2h

# הכתובות שמותר להן לפנות לשרת (האתר בריאקט). כמה כתובות – מפרידים בפסיק.
CORS_ORIGINS=http://localhost:5173

# כמה ניסיונות כניסה/הרשמה מותרים מכל כתובת ב־15 דקות
AUTH_RATE_LIMIT=20

# כמה ימים ספר נחשב "חדש"
NEW_BOOKS_DAYS=30

# --- נתוני הדגמה (npm run db:seed) ---
# בסביבת פיתוח, בלי הערכים האלה, נוצרים gabbai/gabbai1234 ו־mitpalel/mitpalel1234.
# ב־production חובה להגדיר אותם, אחרת לא נוצרים משתמשים.
# SEED_GABBAI_FULLNAME="שם הגבאי"
# SEED_GABBAI_USERNAME=gabbai
# SEED_GABBAI_PASSWORD=
# SEED_USER_USERNAME=
# SEED_USER_PASSWORD=
